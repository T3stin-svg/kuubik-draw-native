/* Kuubik Draw dark design system — GPLv2. */

QWidget {
    color: #E8EBEF;
    background-color: #222933;
    font-family: "Segoe UI";
    font-size: 9pt;
    selection-color: #FFFFFF;
    selection-background-color: #176F9F;
}

QMainWindow, QMdiArea, QMdiSubWindow {
    background-color: #1E2225;
}

QMenuBar {
    min-height: 23px;
    padding: 0 4px;
    color: #DCE2E7;
    background-color: #222933;
    border-bottom: 1px solid #11161B;
}
QMenuBar::item { padding: 4px 8px; background: transparent; }
QMenuBar::item:selected { color: #FFFFFF; background: #3B4453; }

QMenu {
    color: #E8EBEF;
    background-color: #252D35;
    border: 1px solid #596775;
    padding: 4px;
}
QMenu::item { min-height: 22px; padding: 3px 28px 3px 24px; }
QMenu::item:selected { color: #FFFFFF; background-color: #176F9F; }
QMenu::item:disabled { color: #77838D; }
QMenu::separator { height: 1px; margin: 4px 7px; background: #46515C; }

#kuubikRibbonToolbar {
    spacing: 0;
    padding: 0;
    background-color: #222933;
    border: 0;
    border-bottom: 1px solid #11161B;
}
#kuubikRibbonToolbar::handle { width: 0; }
#kuubikRibbon {
    min-height: 148px;
    max-height: 152px;
    background-color: #3B4453;
}
#kuubikQuickAccess {
    min-height: 28px;
    max-height: 28px;
    background-color: #222933;
    border-bottom: 1px solid #11161B;
}
#kuubikApplicationButton {
    min-width: 82px;
    min-height: 22px;
    padding: 1px 7px 1px 5px;
    color: #FFFFFF;
    background-color: #313B48;
    border: 1px solid #536274;
    border-radius: 1px;
    font-weight: 600;
}
#kuubikApplicationButton:hover { background-color: #435064; }
#kuubikApplicationButton:pressed { background-color: #176F9F; border-color: #A8D9F5; }
#kuubikApplicationButton:focus { border-color: #4CC2FF; }
#kuubikWorkspaceLabel {
    min-width: 172px;
    padding: 2px 8px;
    color: #F1F4F6;
    background-color: #3B4453;
    border: 1px solid #546174;
}
#kuubikProductBadge { color: #DFF3FF; font-weight: 600; }
#kuubikOptionToolbarHost {
    min-height: 22px;
    background: transparent;
}
#kuubikQuickButton {
    min-width: 24px;
    max-width: 24px;
    min-height: 22px;
    max-height: 22px;
    padding: 0;
    color: #CBD3DA;
    background: transparent;
    border: 1px solid transparent;
}
#kuubikQuickButton:hover { background: #3B4248; border-color: #59636C; }
#kuubikQuickButton:focus { border-color: #4CC2FF; }
#kuubikQuickButton:pressed, #kuubikQuickButton:checked {
    background: #176F9F;
    border-color: #68B4DF;
}

#kuubikRibbonTabs::pane {
    margin: 0;
    padding: 0;
    background-color: #3B4453;
    border: 0;
}
#kuubikRibbonTabs QTabBar::tab {
    min-width: 72px;
    min-height: 23px;
    padding: 2px 12px;
    color: #D9DFE4;
    background-color: #222933;
    border: 0;
    border-right: 1px solid #11161B;
}
#kuubikRibbonTabs QTabBar::tab:hover { color: #FFFFFF; background: #383E43; }
#kuubikRibbonTabs QTabBar::tab:selected {
    color: #FFFFFF;
    background-color: #3B4453;
    border-top: 3px solid #4CC2FF;
}
#kuubikRibbonPage {
    min-height: 93px;
    background-color: #3B4453;
}
#kuubikRibbonGroup {
    background-color: #3B4453;
    border: 0;
    border-right: 1px solid #29313B;
}
#kuubikRibbonGroup[kuubikCollapsed="true"] {
    min-width: 52px;
    background-color: #35404B;
}
#kuubikRibbonGroupLabel {
    min-height: 15px;
    max-height: 15px;
    color: #D9D9D9;
    background: transparent;
    font-size: 8pt;
}
#kuubikRibbonButton {
    min-width: 76px;
    min-height: 28px;
    padding: 1px 5px;
    color: #F1F4F6;
    background: transparent;
    border: 1px solid transparent;
    text-align: left;
}
#kuubikRibbonButton:hover { background: #48515A; border-color: #707B85; }
#kuubikRibbonButton:focus { border-color: #4CC2FF; }
#kuubikRibbonButton:pressed, #kuubikRibbonButton:checked {
    color: #FFFFFF;
    background: #176F9F;
    border-color: #68B4DF;
}
#kuubikRibbonButton:disabled { color: #7E878E; background: transparent; }
#kuubikRibbonButton[kuubikItemSize="0"] {
    min-width: 62px;
    min-height: 68px;
    padding: 2px 5px 1px;
    text-align: center;
}
#kuubikRibbonButton[kuubikItemSize="1"] {
    min-width: 82px;
    min-height: 30px;
    padding: 2px 5px;
}
#kuubikRibbonButton[kuubikItemSize="2"] {
    min-width: 78px;
    min-height: 29px;
    padding: 1px 4px;
}
#kuubikRibbonPanelOverflow {
    min-width: 48px;
    min-height: 52px;
    padding: 2px;
    color: #DCE5EB;
    background: #35404B;
    border: 1px solid #596775;
}
#kuubikRibbonPanelOverflow:hover { color: #FFFFFF; background: #48515A; border-color: #8AA0B0; }
#kuubikCurrentLayerHost {
    min-width: 176px;
    background-color: #3B4453;
    border-right: 1px solid #29313B;
}
#kuubikCurrentLayerHost QComboBox {
    min-width: 128px;
    min-height: 26px;
    background-color: #18212A;
    border-color: #66839A;
}
#kuubikCurrentLayerPlaceholder {
    min-width: 128px;
    min-height: 26px;
    padding: 2px 6px;
    color: #B7C4CE;
    background-color: #18212A;
    border: 1px solid #52606B;
}
#kuubikCurrentLayerEditButton {
    min-width: 26px;
    max-width: 26px;
    min-height: 26px;
    padding: 1px;
}
#kuubikOptionToolbarHost QToolBar, #kuubikRibbonGroup QToolBar {
    spacing: 1px;
    padding: 0;
    background: transparent;
}
#kuubikOptionToolbarHost QToolButton, #kuubikRibbonGroup QToolButton {
    background-color: transparent;
}

QToolBar {
    spacing: 2px;
    padding: 2px;
    background-color: #3B4453;
    border: 0;
}
QToolBar::separator { width: 1px; margin: 3px; background: #596775; }
QToolButton {
    color: #E7EDF1;
    background-color: #343D46;
    border: 1px solid transparent;
    border-radius: 1px;
    padding: 2px 4px;
}
QToolButton:hover { color: #FFFFFF; background: #48515A; border-color: #707B85; }
QToolButton:pressed, QToolButton:checked {
    color: #FFFFFF;
    background-color: #176F9F;
    border-color: #68B4DF;
}
QToolButton:disabled { color: #78838C; background-color: #303740; }

QDockWidget {
    color: #E8EBEF;
    background-color: #3B4453;
    titlebar-close-icon: url(:/icons/close.svg);
}
QDockWidget::title {
    min-height: 22px;
    padding: 2px 7px;
    color: #EFF2F4;
    background-color: #2E3440;
    border-bottom: 1px solid #202630;
    text-align: left;
}
#layer_dockwidget, #block_dockwidget, #kuubikPropertiesDock {
    background-color: #303945;
    border-left: 1px solid #202630;
}
#layer_dockwidget QTreeView, #block_dockwidget QTreeView, #kuubikPropertiesDock QTreeView {
    background-color: #303945;
    alternate-background-color: #374250;
}

QTabBar::tab {
    min-height: 23px;
    padding: 3px 9px;
    color: #C9D1D7;
    background-color: #2A323A;
    border: 0;
    border-right: 1px solid #171B1E;
}
QTabBar::tab:hover { color: #FFFFFF; background: #363D43; }
QTabBar::tab:selected { color: #FFFFFF; background: #3B4453; border-top: 2px solid #168DCE; }

QLineEdit, QTextEdit, QPlainTextEdit, QSpinBox, QDoubleSpinBox, QComboBox {
    min-height: 21px;
    color: #F4F8FA;
    background-color: #161C22;
    border: 1px solid #52606B;
    border-radius: 1px;
    padding: 1px 4px;
}
QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus,
QSpinBox:focus, QDoubleSpinBox:focus, QComboBox:focus {
    border-color: #5DA9E9;
}
QComboBox::drop-down { width: 18px; border-left: 1px solid #52606B; }
QComboBox QAbstractItemView {
    color: #EEF2F5;
    background-color: #303945;
    border: 1px solid #596775;
    selection-background-color: #176F9F;
}

QTreeView, QTableView, QListView {
    alternate-background-color: #343E4B;
    background-color: #3B4453;
    border: 0;
    gridline-color: #2E3440;
    selection-color: #FFFFFF;
    selection-background-color: #7487A5;
}
QHeaderView::section {
    min-height: 21px;
    padding: 2px 5px;
    color: #E4E9ED;
    background-color: #454F61;
    border: 0;
    border-right: 1px solid #2E3440;
    border-bottom: 1px solid #2E3440;
}

QPushButton {
    min-height: 24px;
    padding: 2px 9px;
    color: #EDF1F4;
    background-color: #41474D;
    border: 1px solid #59636B;
    border-radius: 1px;
}
QPushButton:hover { color: #FFFFFF; background: #505861; border-color: #7D8993; }
QPushButton:pressed, QPushButton:checked { background: #176F9F; border-color: #70B8E3; }
QPushButton:disabled { color: #7D858C; background: #34393E; border-color: #464C51; }

QStatusBar {
    min-height: 27px;
    max-height: 27px;
    color: #E1E7EB;
    background-color: #435166;
    border-top: 1px solid #617086;
    border-bottom: 1px solid #263241;
}
QStatusBar::item { border: 0; }
QStatusBar QLabel { color: #E1E7EB; background: transparent; }
#coordinates {
    min-width: 184px;
    max-width: 184px;
    min-height: 24px;
    max-height: 24px;
    color: #F1F4F6;
    background: #354255;
    border-left: 1px solid #53637A;
    border-right: 1px solid #263241;
}
#coordinates:hover { background: #4D5D72; }
#coordinates QLabel {
    padding-left: 7px;
    color: #F1F4F6;
    font-size: 11px;
}
#kuubikModelStatus {
    min-width: 51px;
    max-width: 51px;
    min-height: 24px;
    max-height: 24px;
    padding: 0;
    color: #FFFFFF;
    background: #39475A;
    border-left: 1px solid #607087;
    border-right: 1px solid #263241;
    font-weight: 600;
    font-size: 11px;
}
#kuubikStatusToggle {
    min-width: 29px;
    max-width: 29px;
    min-height: 24px;
    max-height: 24px;
    padding: 0;
    margin: 0;
    color: #D7DEE4;
    background: transparent;
    border: 0;
}
#kuubikStatusToggle:hover { color: #FFFFFF; background: #5A6980; }
#kuubikStatusToggle:pressed { background: #2D5F87; }
#kuubikStatusToggle:checked { color: #FFFFFF; background: #3A87C1; }
#kuubikStatusToggle:checked:hover { background: #4697D2; }
#kuubikStatusToggle:disabled { color: #8793A0; background: transparent; }

#kuubikStatusSplitToggle {
    min-width: 38px;
    max-width: 38px;
    min-height: 24px;
    max-height: 24px;
    padding: 0 9px 0 0;
    margin: 0;
    color: #D7DEE4;
    background: transparent;
    border: 0;
}
#kuubikStatusSplitToggle:hover { color: #FFFFFF; background: #5A6980; }
#kuubikStatusSplitToggle:pressed { background: #2D5F87; }
#kuubikStatusSplitToggle:checked { color: #FFFFFF; background: #3A87C1; }
#kuubikStatusSplitToggle:checked:hover { background: #4697D2; }
#kuubikStatusSplitToggle::menu-indicator {
    subcontrol-origin: padding;
    subcontrol-position: right center;
    width: 8px;
    height: 18px;
}

#kuubikOsnapButton,
#kuubikIsometricButton {
    min-width: 42px;
    max-width: 42px;
    min-height: 24px;
    max-height: 24px;
    padding: 0 12px 0 1px;
    margin: 0;
    color: #D7DEE4;
    background: transparent;
    border: 0;
}
#kuubikOsnapButton:hover,
#kuubikIsometricButton:hover { color: #FFFFFF; background: #5A6980; }
#kuubikOsnapButton:checked,
#kuubikIsometricButton:checked { color: #FFFFFF; background: #3A87C1; }
#kuubikOsnapButton:checked:hover,
#kuubikIsometricButton:checked:hover { background: #4697D2; }
#kuubikOsnapButton::menu-indicator,
#kuubikIsometricButton::menu-indicator {
    subcontrol-origin: padding;
    subcontrol-position: right center;
    width: 10px;
    border-left: 1px solid rgba(231, 239, 243, 90);
}
#kuubikStatusCustomize {
    min-width: 30px;
    max-width: 30px;
    min-height: 24px;
    max-height: 24px;
    padding: 0;
    margin: 0;
    background: #39475A;
    border: 0;
    border-left: 1px solid #61686D;
}
#kuubikStatusCustomize:hover { background: #5A6980; }
#kuubikStatusCustomize::menu-indicator { image: none; width: 0; }

#kuubikOsnapMenu,
#kuubikStatusCustomizationMenu,
#kuubikStatusSettingsMenu,
#kuubikCoordinateMenu,
#kuubikSnapModeMenu,
#kuubikPolarMenu,
#kuubikDynamicInputMenu,
#kuubikIsometricMenu {
    min-width: 220px;
    padding: 5px 0;
    color: #E6EBEF;
    background: #3F4C5F;
    border: 1px solid #718097;
}
#kuubikOsnapMenu::item,
#kuubikStatusCustomizationMenu::item,
#kuubikStatusSettingsMenu::item,
#kuubikCoordinateMenu::item,
#kuubikSnapModeMenu::item,
#kuubikPolarMenu::item,
#kuubikDynamicInputMenu::item,
#kuubikIsometricMenu::item { min-height: 23px; padding: 2px 28px 2px 30px; }
#kuubikOsnapMenu::item:selected,
#kuubikStatusCustomizationMenu::item:selected,
#kuubikStatusSettingsMenu::item:selected,
#kuubikCoordinateMenu::item:selected,
#kuubikSnapModeMenu::item:selected,
#kuubikPolarMenu::item:selected,
#kuubikDynamicInputMenu::item:selected,
#kuubikIsometricMenu::item:selected { background: #3A87C1; color: white; }
#kuubikOsnapMenu::indicator,
#kuubikStatusCustomizationMenu::indicator,
#kuubikCoordinateMenu::indicator,
#kuubikSnapModeMenu::indicator,
#kuubikPolarMenu::indicator,
#kuubikDynamicInputMenu::indicator,
#kuubikIsometricMenu::indicator { width: 14px; height: 14px; left: 7px; }
#kuubikOsnapMenu::separator,
#kuubikStatusCustomizationMenu::separator,
#kuubikStatusSettingsMenu::separator,
#kuubikCoordinateMenu::separator,
#kuubikSnapModeMenu::separator,
#kuubikPolarMenu::separator,
#kuubikDynamicInputMenu::separator,
#kuubikIsometricMenu::separator { height: 1px; background: #686E73; margin: 5px 7px; }

#command_dockwidget { background-color: #222933; }
#command_dockwidget QLineEdit, #command_dockwidget QTextEdit {
    color: #FFFFFF;
    background-color: #111820;
    border-color: #52606B;
    font-family: Consolas, "Courier New";
}
#command_dockwidget QLabel { color: #C6CED4; background: transparent; }
#command_dockwidget QPlainTextEdit {
    color: #BFCAD2;
    background-color: #151B21;
    border-color: #303B46;
    font-family: Consolas, "Courier New";
}

QScrollBar:vertical { width: 11px; background: #252D35; }
QScrollBar::handle:vertical { min-height: 24px; background: #596775; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar:horizontal { height: 11px; background: #252D35; }
QScrollBar::handle:horizontal { min-width: 24px; background: #596775; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; }

QToolTip {
    color: #EDF3F7;
    background-color: #202731;
    border: 1px solid #5D6A78;
    padding: 4px;
}
